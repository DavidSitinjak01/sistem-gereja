generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Member {
  id               String   @id @default(cuid())
  name             String
  gender           String?  // LAKI-LAKI, PEREMPUAN
  occupation       String?  // Pekerjaan
  phone            String?  // No Hp/WA
  address          String?
  maritalStatus    String?  // MENIKAH, BELUM MENIKAH, MUDA-MUDI, REMAJA, SEKOLAH MINGGU
  membershipStatus String   @default("AKTIF") // AKTIF, NON-AKTIF
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  name        String
  dayOfWeek   String?  // MINGGU, SENIN, SELASA, etc.
  time        String?  // e.g., 08:00
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  attendance   Attendance[]
  weeklySongs  WeeklySong[]
}

model ChurchEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Finance {
  id          String   @id @default(cuid())
  type        String   // PEMASUKAN, PENGELUARAN
  category    String   // PERSEPULUHAN, PERSEMBAHAN, DONASI, OPERASIONAL, RENOVASI, etc.
  amount      Float
  description String?
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Attendance {
  id          String   @id @default(cuid())
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id])
  date        DateTime
  memberCount Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Song {
  id          String   @id @default(cuid())
  title       String
  artist      String?
  category    String?  // PUJIAN, PENYEMBAHAN, NATAL, PASKAH, LAIN-LAIN
  lyrics      String?
  chord       String?  // Key chord, e.g. C, D, G
  songNumber  String?  // Nomor lagu buku nyanyian
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  weeklySongs WeeklySong[]
}

model WeeklySong {
  id        String   @id @default(cuid())
  songId    String
  song      Song     @relation(fields: [songId], references: [id])
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id])
  weekDate  DateTime // tanggal Minggu/ibadah minggu itu
  order     Int      @default(1) // urutan lagu dalam ibadah
  note      String?  // catatan: lagu pembuka, persembahan, penutup
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChurchSetting {
  id         String   @id @default("default")
  churchName String   @default("Gereja")
  logo       String?  // Logo as base64 data URL
  province   String?  // Provinsi
  regency    String?  // Kabupaten
  district   String?  // Kecamatan
  village    String?  // Desa/Kelurahan
  pastor     String?  // Pendeta
  treasurer  String?  // Bendahara
  secretary  String?  // Sekretaris
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  password  String
  role      String   @default("PELAYAN") // ADMIN, BENDAHARA, PELAYAN, SEKRETARIS, PENDETA
  servantNo Int?     // Nomor pelayan (1, 2, 3, dst) — hanya untuk role PELAYAN
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
